# =============================================================================
# VATGuard – Environment Configuration
# =============================================================================

# Application
APP_NAME=VATGuard
APP_ENV=development          # development | staging | production
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://vatguard:vatguard@localhost:5432/vatguard
DATABASE_SYNC_URL=postgresql://vatguard:vatguard@localhost:5432/vatguard

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Auth
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Risk Score Thresholds
RISK_SCORE_HIGH_THRESHOLD=75
RISK_SCORE_CRITICAL_THRESHOLD=90

# Fraud Detection Tuning
CAROUSEL_MIN_CHAIN_DEPTH=3
MISSING_TRADER_DAYS_INACTIVE=90
INVOICE_MILL_MIN_INVOICES_PER_DAY=50
REFUND_FRAUD_RATIO_THRESHOLD=0.8
BENFORD_CHI2_SIGNIFICANCE=0.05

# External Integrations
# Tax Management System
TMS_BASE_URL=https://tms.authority.gov/api/v1
TMS_API_KEY=your-tms-api-key
TMS_TIMEOUT_SECONDS=30

# Customs Management System
CUSTOMS_BASE_URL=https://customs.authority.gov/api/v1
CUSTOMS_API_KEY=your-customs-api-key
CUSTOMS_TIMEOUT_SECONDS=30

# Financial Intelligence Unit
FIU_BASE_URL=https://fiu.authority.gov/api/v1
FIU_API_KEY=your-fiu-api-key
FIU_TIMEOUT_SECONDS=30

# Business Register
BUSINESS_REGISTER_BASE_URL=https://register.authority.gov/api/v1
BUSINESS_REGISTER_API_KEY=your-register-api-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json           # json | console
